if(NOT DEFINED BORINGSSL_SOURCE_DIR)
  message(FATAL_ERROR "BORINGSSL_SOURCE_DIR is not set")
endif()

set(SPAKE2_SOURCE
  "${BORINGSSL_SOURCE_DIR}/crypto/curve25519/spake25519.cc")

if(NOT EXISTS "${SPAKE2_SOURCE}")
  message(FATAL_ERROR
    "BoringSSL SPAKE2 source not found: ${SPAKE2_SOURCE}")
endif()

file(READ "${SPAKE2_SOURCE}" CONTENT)

set(PATTERN
  "  uint8_t private_tmp\\[64\\];[ \t]*\n[ \t]*RAND_bytes\\(private_tmp, sizeof\\(private_tmp\\)\\);")

string(REGEX MATCH "${PATTERN}" MATCHED "${CONTENT}")

if(NOT MATCHED)
  message(FATAL_ERROR
    "Could not find expected SPAKE2 RAND_bytes() code in "
    "spake25519.cc. BoringSSL source may have changed.")
endif()

# The following code is a patch for deterministic SPAKE2 testing.
set(REPLACEMENT
"  uint8_t private_tmp[64] = {0};

  /*
   * The following code is a patch for deterministic SPAKE2 testing.
   * Do not use deterministic randomness in production.
   */
   static const uint8_t kAliceRandom[64] = {
      0x7a, 0x13, 0xe4, 0x9b, 0x26, 0x5d, 0xc8, 0x41,
      0xf0, 0x8e, 0x37, 0xaa, 0x6c, 0x19, 0xd2, 0x75,
      0x4f, 0xb8, 0x02, 0xe1, 0x93, 0x56, 0xcd, 0x28,
      0x6a, 0xf4, 0x81, 0x3c, 0xb5, 0x0e, 0x97, 0xd9,
      0x44, 0x72, 0x1f, 0xca, 0x85, 0x3b, 0xe7, 0x60,
      0x0d, 0x96, 0x54, 0xaf, 0x38, 0xc1, 0x7e, 0x25,
      0xdb, 0x49, 0x68, 0xf3, 0x17, 0x8a, 0xbe, 0x52,
      0x31, 0xec, 0x06, 0x9d, 0x73, 0x45, 0xc7, 0xb0
  };
  
  static const uint8_t kBobRandom[64] = {
      0x91, 0x3e, 0xb7, 0x04, 0xda, 0x68, 0x2f, 0xc5,
      0x17, 0x84, 0xf9, 0x3b, 0x6d, 0xa2, 0x50, 0xce,
      0x79, 0x0b, 0xe3, 0x46, 0xbc, 0x15, 0x98, 0x72,
      0xd4, 0x2a, 0x61, 0xf6, 0x0c, 0x85, 0x39, 0xaf,
      0x57, 0xc3, 0x1e, 0x9a, 0x70, 0x4d, 0xe8, 0x23,
      0xb1, 0x66, 0x0f, 0xd8, 0x43, 0x95, 0x2c, 0xfa,
      0x81, 0x34, 0x5b, 0xc9, 0x16, 0xa7, 0x6e, 0x08,
      0xde, 0x40, 0x53, 0xbd, 0x27, 0x8c, 0xf2, 0x69
  };

  OPENSSL_memcpy(
    private_tmp,
    ctx->my_role == spake2_role_alice
      ? kAliceRandom
      : kBobRandom,
    sizeof(private_tmp));"
)

string(REGEX REPLACE
  "${PATTERN}"
  "${REPLACEMENT}"
  CONTENT
  "${CONTENT}"
)

file(WRITE "${SPAKE2_SOURCE}" "${CONTENT}")

message(STATUS
  "Patched BoringSSL SPAKE2 to use deterministic random data")
